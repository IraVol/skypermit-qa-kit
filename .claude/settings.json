{
  "model": "opus",
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "permissions": {
    "defaultMode": "plan",
    "plan": [
      "Read",
      "Glob",
      "Grep",
      "LS"
    ],
    "allow": [
      "Edit",
      "Write",
      "Read",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(git *)",
      "Bash(nest *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(jest *)",
      "Bash(docker *)",
      "Bash(make *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(npm publish *)",
      "Bash(npm install *)",
      "Bash(docker rm *)",
      "Bash(docker system prune *)",
      "Edit(../skypermit/**)"
    ],
    "deny": [
      "Read(.git/*)",
      "Read(.git/**/*)",
      "Edit(.git/*)",
      "Edit(.git/**/*)",
      "Read(env/*)",
      "Read(.npmrc)",
      "Read(.env*)",
      "Read(secrets/*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Edit(env/*)",
      "Edit(.npmrc)",
      "Edit(.env*)",
      "Edit(secrets/*)",
      "Edit(*.key)",
      "Edit(*.pem)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf env/*)",
      "Bash(cat .git/*)",
      "Bash(cat env/*)",
      "Bash(cat .npmrc)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch"
    ],
    "additionalDirectories": [
      "../skypermit"
    ]
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-cost.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
